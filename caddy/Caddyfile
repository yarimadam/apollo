{
	default_sni {$INTERNAL_IP}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	handle /robots.txt {
		root * /etc/caddy/static
		file_server
	}
}

{$INTERNAL_IP}:9000 {
	tls internal
	reverse_proxy portainer:9000
}

{$AIOSTREAMS_DOMAIN} {
	{$CADDY_EXTERNAL_TLS}
	import noindex

	handle {
		reverse_proxy aiostreams:3000
	}
}

{$AIOMETADATA_DOMAIN} {
	{$CADDY_EXTERNAL_TLS}
	import noindex

	handle {
		reverse_proxy aiometadata:3232
	}
}
