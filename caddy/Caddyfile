{
	default_sni {$INTERNAL_IP}
}

{$INTERNAL_IP}:8443 {
	tls internal
	reverse_proxy portainer:9000
}

{$AIOSTREAMS_DOMAIN} {
	{$CADDY_EXTERNAL_TLS}
	header X-Robots-Tag "noindex, nofollow, noarchive"

	route {
		respond /robots.txt `User-agent: *
Disallow: /
` 200
		reverse_proxy aiostreams:3000
	}
}

{$AIOMETADATA_DOMAIN} {
	{$CADDY_EXTERNAL_TLS}
	header X-Robots-Tag "noindex, nofollow, noarchive"

	route {
		respond /robots.txt `User-agent: *
Disallow: /
` 200
		reverse_proxy aiometadata:3232
	}
}
