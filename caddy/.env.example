# Caddy's HTTPS port.
CADDY_HTTPS_PORT=443

# Caddy's HTTP port (ACME challenge + HTTPS redirect).
CADDY_HTTP_PORT=80

# TLS for AIOStreams, AIOMetadata and SlickSync. Keep as is for self-signed
# certificates. Leave empty to enable Let's Encrypt certificates.
CADDY_TLS='tls internal'

# Public hostname of AIOStreams. Must match aiostreams/.env AIOSTREAMS_BASE_URL.
AIOSTREAMS_DOMAIN=aiostreams.apollo

# Public hostname of AIOMetadata. Must match aiometadata/.env AIOMETADATA_HOST_NAME.
AIOMETADATA_DOMAIN=aiometadata.apollo

# Public hostname of SlickSync. Must match slicksync/.env SLICKSYNC_PUBLIC_APP_URL.
SLICKSYNC_DOMAIN=slicksync.apollo
