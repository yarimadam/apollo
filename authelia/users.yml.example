# Authelia's users. Copy to users.yml (git-ignored) and replace the example.
#
# Hash a password via:
#   docker run --rm -it authelia/authelia:4.39.28 authelia crypto hash generate argon2
#
# Restart Authelia after editing: task down:authelia up:authelia
users:
  admin:
    disabled: false
    displayname: Admin
    email: admin@example.com
    password: '$argon2id$v=19$m=65536,t=3,p=4$REPLACE$ME'
