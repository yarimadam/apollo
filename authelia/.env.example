# Parent domain of every public hostname; the login cookie is scoped to it.
DOMAIN=example.com

# Public hostname of the login portal. Must match traefik/.env AUTH_DOMAIN.
AUTH_DOMAIN=auth.example.com

# Hostnames whose config and admin pages need a login. Must match
# traefik/.env.
AIOSTREAMS_DOMAIN=aiostreams.example.com
AIOMETADATA_DOMAIN=aiometadata.example.com
SLICKSYNC_DOMAIN=slicksync.example.com

# Signs login sessions.
# Generate via: openssl rand -hex 64
AUTHELIA_SESSION_SECRET=

# Encrypts the 2FA registrations in the database. Immutable after first run;
# losing it forces every user to re-register 2FA.
# Generate via: openssl rand -hex 64
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# Must match redis/.env PASSWORD.
AUTHELIA_SESSION_REDIS_PASSWORD=
