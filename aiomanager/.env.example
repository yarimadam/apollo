# External URL of AIOManager, the only origin allowed to call its API
# (caddy/.env AIOMANAGER_DOMAIN).
CORS_ORIGINS=https://aiomanager.example.com

# Encrypts stored Stremio auth keys, connection credentials and autopilot
# rules. Immutable after first run.
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=

# Anyone who reaches AIOManager can create an account on it. Keep false only
# until your own account exists (created on its first cloud sync), then set
# true and re-run task up:aiomanager.
REGISTRATIONS_CLOSED=false
