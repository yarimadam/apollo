# Traefik's HTTPS port.
HTTPS_PORT=443

# Traefik's HTTP port (ACME challenge + HTTPS redirect).
HTTP_PORT=80

# IP that Traefik's dashboard (8443, self-signed) binds to.
#
# CAUTION: Set this to an internal IP (e.g. your Tailscale IP from
# `tailscale ip -4`), or keep 127.0.0.1 and access it via an SSH tunnel.
# Don't bind to a public interface unless you know what you're doing.
INTERFACE=127.0.0.1

# Certificates for the public sites. Keep as is for Let's Encrypt. Leave
# empty for Traefik's self-signed default certificate (local dev).
CERT_RESOLVER=letsencrypt

# Public hostname of AIOStreams. Must match aiostreams/.env BASE_URL.
AIOSTREAMS_DOMAIN=aiostreams.example.com

# Public hostname of AIOMetadata. Must match aiometadata/.env HOST_NAME.
AIOMETADATA_DOMAIN=aiometadata.example.com

# Public hostname of SlickSync. Must match slicksync/.env PUBLIC_APP_URL.
SLICKSYNC_DOMAIN=slicksync.example.com

# Public hostname of Authelia's login portal. Must match
# authelia/.env AUTH_DOMAIN.
AUTH_DOMAIN=auth.example.com
