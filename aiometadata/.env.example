# External URL of AIOMetadata. Must match how clients reach it
# (caddy/.env AIOMETADATA_DOMAIN).
AIOMETADATA_HOST_NAME=https://aiometadata.apollo

# Protects AIOMetadata's /api/dashboard only, not catalogs/configure.
# Generate via: openssl rand -hex 32
AIOMETADATA_ADMIN_KEY=

# Gates AIOMetadata config creation behind login.
# Generate via: openssl rand -hex 16
AIOMETADATA_ADDON_PASSWORD=

# Must match redis/.env REDIS_PASSWORD.
REDIS_PASSWORD=
