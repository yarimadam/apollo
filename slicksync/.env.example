# External URL of SlickSync. Devices install SlickTrax from it
# (caddy/.env SLICKSYNC_DOMAIN).
SLICKSYNC_PUBLIC_APP_URL=https://slicksync.apollo

# Signs SlickSync login sessions.
# Generate via: openssl rand -base64 32
SLICKSYNC_JWT_SECRET=

# SlickSync dashboard login. Required, else open admin access.
# Generate via: openssl rand -hex 10
SLICKSYNC_USERNAME=
# Generate via: openssl rand -hex 20
SLICKSYNC_PASSWORD=

# SlickSync's own AIOStreams login. Polls live streams for Now Playing.
# Must match the SlickSync entry in aiostreams/.env AIOSTREAMS_AUTH.
SLICKSYNC_AIOSTREAMS_USERNAME=
SLICKSYNC_AIOSTREAMS_PASSWORD=

# Optional: the server's public IP(s), comma-separated. Streams from these
# are the server's own requests, not a user watching; recorded, they show up
# as phantom Now Playing sessions.
SLICKSYNC_AIOSTREAMS_IGNORE_IPS=
