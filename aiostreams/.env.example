# External URL of AIOStreams. Must match how clients reach it
# (caddy/.env AIOSTREAMS_DOMAIN).
AIOSTREAMS_BASE_URL=https://aiostreams.apollo

# Encrypts AIOStreams' stored configs. Immutable after first run.
# Generate via: openssl rand -hex 32
AIOSTREAMS_SECRET_KEY=

# AIOStreams admin logins, comma-separated user:pass entries. Required, else
# open admin access. Also gates config creation.
# Generate via: echo "$(openssl rand -hex 10):$(openssl rand -hex 10)"
#
# If you run SlickSync, add a second entry for its Now Playing poller (the
# live-streams endpoint is admin-only) and put the same user and password in
# slicksync/.env SLICKSYNC_AIOSTREAMS_USERNAME / SLICKSYNC_AIOSTREAMS_PASSWORD.
# Generate via: echo "slicksync-$(openssl rand -hex 4):$(openssl rand -hex 20)"
AIOSTREAMS_AUTH=

# Must match redis/.env REDIS_PASSWORD.
REDIS_PASSWORD=
