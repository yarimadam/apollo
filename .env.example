# IP that Portainer's HTTPS (9443, self-signed) binds to.
#
# CAUTION: Set this to an internal IP (e.g. your Tailscale IP from
# `tailscale ip -4`), or keep 127.0.0.1 and access it via an SSH tunnel.
# Don't bind to a public interface unless you know what you're doing.
PORTAINER_INTERFACE=127.0.0.1

# Caddy's HTTPS port.
CADDY_HTTPS_PORT=443

# Caddy's HTTP port (ACME challenge + HTTPS redirect).
CADDY_HTTP_PORT=80

# TLS for AIOStreams and AIOMetadata. Keep as is for self-signed certificates.
# Leave empty to enable Let's Encrypt certificates.
CADDY_TLS='tls internal'

# Public hostname of AIOStreams.
AIOSTREAMS_DOMAIN=aiostreams.apollo

# External URL of AIOStreams. Must match how clients reach it.
AIOSTREAMS_BASE_URL=https://aiostreams.apollo

# Encrypts AIOStreams' stored configs. Immutable after first run.
# Generate via: openssl rand -hex 32
AIOSTREAMS_SECRET_KEY=

# AIOStreams dashboard login (user:pass). Required, else open admin access.
# Generate via: echo "$(openssl rand -hex 10):$(openssl rand -hex 10)"
AIOSTREAMS_AUTH=

# Gates config creation behind login defined by AIOSTREAMS_AUTH.
AIOSTREAMS_AUTH_REQUIRED=true

# Public hostname of AIOMetadata.
AIOMETADATA_DOMAIN=aiometadata.apollo

# External URL of AIOMetadata. Must match how clients reach it.
AIOMETADATA_HOST_NAME=https://aiometadata.apollo

# Protects AIOMetadata's /api/dashboard only, not catalogs/configure.
# Generate via: openssl rand -hex 32
AIOMETADATA_ADMIN_KEY=

# Gates AIOMetadata config creation behind login.
# Generate via: openssl rand -hex 16
AIOMETADATA_ADDON_PASSWORD=

# Public hostname of SlickSync.
SLICKSYNC_DOMAIN=slicksync.apollo

# External URL of SlickSync. Devices install SlickTrax from it.
SLICKSYNC_PUBLIC_APP_URL=https://slicksync.apollo

# Signs SlickSync login sessions.
# Generate via: openssl rand -base64 32
SLICKSYNC_JWT_SECRET=

# SlickSync dashboard login. Required, else open admin access.
# Generate via: openssl rand -hex 10
SLICKSYNC_USERNAME=
# Generate via: openssl rand -hex 20
SLICKSYNC_PASSWORD=

# SlickSync's own AIOStreams login, added alongside AIOSTREAMS_AUTH. Polls
# live streams for Now Playing. AIOStreams admin, since that endpoint is
# admin-only.
# Generate via: echo "slicksync-$(openssl rand -hex 4)"
SLICKSYNC_AIOSTREAMS_USERNAME=
# Generate via: openssl rand -hex 20
SLICKSYNC_AIOSTREAMS_PASSWORD=

# Optional: the server's public IP(s), comma-separated. Streams from these
# are the server's own requests, not a user watching; recorded, they show up
# as phantom Now Playing sessions.
SLICKSYNC_AIOSTREAMS_IGNORE_IPS=

# Password for the Redis instance.
# Generate via: openssl rand -hex 24
REDIS_PASSWORD=

# Encrypts the restic backup repo. Losing it loses all backups.
# Generate via: openssl rand -hex 32
RESTIC_PASSWORD=

# Optional: restic backend URL for offsite backups, e.g.
# s3:https://<account-id>.r2.cloudflarestorage.com/<bucket> for Cloudflare R2.
# Empty = local-only, stored in backup/restic-repo/.
RESTIC_REPOSITORY=

# Only used if RESTIC_REPOSITORY is S3-compatible (AWS S3, R2, ...).
# Standard S3 credential env var names, regardless of provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
