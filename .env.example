# IP that Portainer's HTTPS (9443, self-signed) binds to.
#
# CAUTION: Set this to an internal IP (e.g. your Tailscale IP from
# `tailscale ip -4`), or keep 127.0.0.1 and access it via an SSH tunnel.
# Don't bind to a public interface unless you know what you're doing.
PORTAINER_INTERFACE=127.0.0.1

# Caddy's HTTPS port. 8444 locally, 443 in production.
CADDY_HTTPS_PORT=8444

# Caddy's HTTP port (ACME challenge + HTTPS redirect).
# 8080 locally, 80 in production.
CADDY_HTTP_PORT=8080

# TLS for AIOStreams and AIOMetadata. tls internal locally; empty in
# production (real Let's Encrypt cert).
CADDY_TLS=tls internal

# Public hostname for AIOStreams. Add "127.0.0.1 <domain>" to /etc/hosts locally.
AIOSTREAMS_DOMAIN=aiostreams.example.com

# External URL AIOStreams uses for its own links. Must match how clients reach it.
AIOSTREAMS_BASE_URL=https://aiostreams.example.com:8444

# Encrypts AIOStreams' stored configs. Immutable after first run.
# openssl rand -hex 32
AIOSTREAMS_SECRET_KEY=

# AIOStreams dashboard login (user:pass). Required, else open admin access.
AIOSTREAMS_AUTH=

# Gates config creation behind login. Existing config URLs unaffected.
AIOSTREAMS_AUTH_REQUIRED=true

# Public hostname for AIOMetadata. Same rules as AIOSTREAMS_DOMAIN.
AIOMETADATA_DOMAIN=aiometadata.example.com
AIOMETADATA_HOST_NAME=https://aiometadata.example.com:8444

# Protects AIOMetadata's /api/dashboard only, not catalogs/configure.
# openssl rand -hex 32
AIOMETADATA_ADMIN_KEY=

# Gates AIOMetadata config creation. Existing config URLs unaffected.
# openssl rand -hex 16
AIOMETADATA_ADDON_PASSWORD=

# Password for the aiometadata_redis instance. openssl rand -hex 24
REDIS_PASSWORD=

# Encrypts the restic backup repo. Losing it loses all backups.
# openssl rand -hex 32
RESTIC_PASSWORD=

# Optional: restic backend URL for offsite backups, e.g.
# s3:https://<account-id>.r2.cloudflarestorage.com/<bucket> for Cloudflare R2.
# Empty = local-only, stored in backup/restic-repo/.
RESTIC_REPOSITORY=

# Only used if RESTIC_REPOSITORY is S3-compatible (R2, B2, MinIO, AWS S3,
# ...). Standard S3 credential env var names, regardless of provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
