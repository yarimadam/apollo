# Public/LAN interface. External sites bind here.
EXTERNAL_IP=127.0.0.1

# Tailscale IP. Internal HTTPS listener binds here only; routing itself is by
# PORTAINER_DOMAIN, not this IP. Run `tailscale ip -4`.
INTERNAL_IP=127.0.0.1

# Internal HTTPS port. 8443 locally, 443 in production.
INTERNAL_HTTPS_PORT=8443

# External HTTPS port. Must differ from INTERNAL_HTTPS_PORT locally.
# 8444 locally, 443 in production.
EXTERNAL_HTTPS_PORT=8444

# External HTTP port (ACME challenge + HTTPS redirect).
# 8080 locally, 80 in production.
EXTERNAL_HTTP_PORT=8080

# Public hostname for AIOStreams. Add "127.0.0.1 <domain>" to /etc/hosts locally.
AIOSTREAMS_DOMAIN=aiostreams.example.com

# External URL AIOStreams uses for its own links. Must match how clients reach it.
AIOSTREAMS_BASE_URL=https://aiostreams.example.com:8444

# TLS for external sites. tls internal locally; empty in production (real
# Let's Encrypt cert).
CADDY_EXTERNAL_TLS=tls internal

# Portainer's Tailscale MagicDNS name. Caddy auto-fetches/renews its cert via
# tailscaled for *.ts.net names. Requires HTTPS Certificates enabled in the
# Tailscale admin console. Fake domain + /etc/hosts entry locally.
PORTAINER_DOMAIN=portainer.local.test

# TLS for Portainer's internal site. tls internal locally; empty in
# production (Caddy's Tailscale cert manager).
CADDY_INTERNAL_TLS=tls internal

# Encrypts AIOStreams' stored configs. Immutable after first run.
# openssl rand -hex 32
AIOSTREAMS_SECRET_KEY=

# AIOStreams dashboard login (user:pass). Required, else open admin access.
AIOSTREAMS_AUTH=

# Gates config creation behind login. Existing config URLs unaffected.
AIOSTREAMS_AUTH_REQUIRED=true

# Public hostname for AIOMetadata. Same rules as AIOSTREAMS_DOMAIN.
AIOMETADATA_DOMAIN=aiometadata.example.com
AIOMETADATA_HOST_NAME=https://aiometadata.example.com:8444

# Users supply their own TMDB key. Optional shared fallback: BUILT_IN_TMDB_API_KEY.

# Protects AIOMetadata's /api/dashboard only, not catalogs/configure.
# openssl rand -hex 32
AIOMETADATA_ADMIN_KEY=

# Password for the aiometadata_redis instance. openssl rand -hex 24
REDIS_PASSWORD=

# Gates AIOMetadata config creation. Existing config URLs unaffected.
# openssl rand -hex 16
AIOMETADATA_ADDON_PASSWORD=

# Encrypts the restic backup repo. Losing it loses all backups.
# openssl rand -hex 32
RESTIC_PASSWORD=
