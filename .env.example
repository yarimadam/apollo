# Public/LAN-facing interface. Caddy binds externally-reachable sites (e.g. AIOStreams) here.
EXTERNAL_IP=127.0.0.1

# Tailscale interface IP — Caddy binds Portainer's HTTPS listener here only,
# so Portainer is reachable exclusively over the tailnet.
# Replace with your actual Tailscale IP (run `tailscale ip -4` to find it), e.g. 100.x.y.z
INTERNAL_IP=127.0.0.1

# Host port for the internal (Tailscale) HTTPS listener, e.g. Portainer via Caddy.
# Defaults to 8443 if unset — on OrbStack, port 443 is claimed by its own
# domain-routing gateway, so avoid it locally.
INTERNAL_HTTPS_PORT=8443

# Host port for Caddy's external HTTPS listener (e.g. AIOStreams).
# Defaults to 8444 if unset. Locally EXTERNAL_IP == INTERNAL_IP, so this must
# differ from INTERNAL_HTTPS_PORT to avoid a collision.
EXTERNAL_HTTPS_PORT=8444

# Host port for Caddy's external HTTP listener (ACME challenge + redirect to HTTPS).
# Defaults to 8080 locally to dodge OrbStack's own port-80 gateway; use 80 in production.
EXTERNAL_HTTP_PORT=8080

# Public hostname for AIOStreams. Needs a real DNS A record pointing at this
# host's public IP in production. For local dev, add
# "127.0.0.1 <this domain>" to /etc/hosts so it resolves locally.
AIOSTREAMS_DOMAIN=aiostreams.example.com

# Full external URL AIOStreams uses to generate its own install/stream links.
# Must match how clients actually reach it (include :port if non-standard).
AIOSTREAMS_BASE_URL=https://aiostreams.example.com:8444

# Caddy TLS directive, shared by every external site (AIOStreams, AIOMetadata, ...).
#   Local dev:  tls internal   (self-signed; browser/clients will warn, that's fine)
#   Production: <leave empty>  (Caddy gets a real cert via Let's Encrypt automatically)
CADDY_EXTERNAL_TLS=tls internal

# 64-char hex secret AIOStreams uses to encrypt stored configs.
# Generate with: openssl rand -hex 32
# CANNOT change after first run without breaking existing configs.
AIOSTREAMS_SECRET_KEY=

# Operator login for the AIOStreams dashboard (user:pass). Required — without
# it, any visitor who reaches the service gets full admin with no login.
AIOSTREAMS_AUTH=

# Public hostname for AIOMetadata. Same rules as AIOSTREAMS_DOMAIN: real DNS A
# record in production, "127.0.0.1 <domain>" in /etc/hosts for local dev.
AIOMETADATA_DOMAIN=aiometadata.example.com
AIOMETADATA_HOST_NAME=https://aiometadata.example.com:8444

# No TMDB key needed here: each user enters their own on AIOMetadata's own
# configure page (stored in their config, never touches this infra). If you
# want a shared fallback key for visitors who haven't set one, get one free at
# https://www.themoviedb.org/settings/api and wire it in as BUILT_IN_TMDB_API_KEY.

# Protects AIOMetadata's /api/dashboard admin endpoints only — NOT the configure
# page or catalogs, which stay public by design (Stremio needs to reach them).
# Generate with: openssl rand -hex 32
AIOMETADATA_ADMIN_KEY=

# Shared password for the aiometadata_redis instance (defense-in-depth: other
# containers on the apollo network could otherwise reach it unauthenticated).
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=

# Encrypts the restic backup repository (portainer/aiostreams/aiometadata/caddy
# data volumes — redis is skipped, it's just a rebuildable cache). Local disk
# for now (backup/restic-repo/); point RESTIC_REPOSITORY in backup/compose.yaml
# at remote storage (e.g. an rclone remote for Google Drive, or S3/B2) later.
# Store this password somewhere separate too (e.g. a password manager) — losing
# it means losing access to every backup. Generate with: openssl rand -hex 32
RESTIC_PASSWORD=
