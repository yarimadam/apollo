# Secrets — real values live only here, never commit. .env.example is the template.
.env

# Local restic backup repository — large, binary, and itself contains a copy
# of every other service's data. Never belongs in git.
backup/restic-repo/

# Tailscale-issued cert/key for Portainer's internal site (production only).
# See caddy/renew-tailscale-cert.sh.
caddy/tailscale-certs/*
!caddy/tailscale-certs/.gitkeep

# Generated by caddy/install-cron.sh — bakes in this host's absolute repo path.
caddy/tailscale-cert.cron

# JetBrains project/workspace state
.idea/

# macOS Finder metadata
.DS_Store
